    "content": "generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id        String   @id @default(uuid())
  name String
  sku String @unique
  description String?
  price Float
  quantity Float @default(0)
  category String? @default("Other")
  inStock Boolean? @default(true)
  releasedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

model Category {
  id        String   @id @default(uuid())
  title String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model Supplier {
  id        String   @id @default(uuid())
  companyName String
  active Boolean @default(true)
  ownerId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("suppliers")
}
",
    "path": "backend/prisma/schema.prisma",
  },
  {
    "content": "import express from 'express';
import { env, trustProxySetting } from './config/env';
import { prisma } from './lib/prisma';
import { errorHandler, notFound } from './middleware/errorHandler';
import { logger } from './middleware/logger';
import { rateLimit } from './middleware/rateLimit';
import { productRouter } from './modules/product/product.routes';
import { categoryRouter } from './modules/category/category.routes';
import { supplierRouter } from './modules/supplier/supplier.routes';

export function createApp() {
  const app = express();
  app.set('trust proxy', trustProxySetting(env.TRUST_PROXY));

  app.use(logger);

  app.get('/api/health', async (_req, res) => {
    try {
      await prisma.$queryRaw\`SELECT 1\`;
      res.json({ status: 'ok' });
    } catch {
      res.status(503).json({ status: 'error', db: 'down' });
    }
  });

  app.use(rateLimit(env.RATE_LIMIT_PER_MIN));
  app.use(express.json());
  // Tuần 4: gắn middleware đăng nhập (parse token) ngay đây; phân quyền gắn trong từng router.
  app.use('/api/products', productRouter);
  app.use('/api/categories', categoryRouter);
  app.use('/api/suppliers', supplierRouter);

  app.use(notFound);
  app.use(errorHandler);
  return app;
}
",
