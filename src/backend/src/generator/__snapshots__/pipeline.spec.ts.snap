  {
    "content": "import type { Student, StudentInput } from '../types/student';
import { api } from './client';
import type { ListParams, ListResult } from './types';

const BASE = '/students';

export const studentApi = {
  async list(params: ListParams = {}): Promise<ListResult<Student>> {
    const res = await api.get<ListResult<Student>>(BASE, { params });
    return res.data;
  },

  async get(id: string): Promise<Student> {
    const res = await api.get<{ data: Student }>(\`\${BASE}/\${id}\`);
    return res.data.data;
  },

  async create(input: StudentInput): Promise<Student> {
    const res = await api.post<{ data: Student }>(BASE, input);
    return res.data.data;
  },

  async update(id: string, input: StudentInput): Promise<Student> {
    const res = await api.put<{ data: Student }>(\`\${BASE}/\${id}\`, input);
    return res.data.data;
  },

  async remove(id: string): Promise<void> {
    await api.delete(\`\${BASE}/\${id}\`);
  },
};
",
