import * as service from './category.service';

export async function list(req: Request, res: Response) {
  res.json(await service.listCategory(parseListQuery(req.query)));
}

export async function get(req: Request<{ id: string }>, res: Response) {
  res.json({ data: await service.getCategory(req.params.id) });
}

export async function create(req: Request, res: Response) {
  res.status(201).json({ data: await service.createCategory(req.body) });
}

export async function update(req: Request<{ id: string }>, res: Response) {
  res.json({ data: await service.updateCategory(req.params.id, req.body) });
}

export async function remove(req: Request<{ id: string }>, res: Response) {
  await service.deleteCategory(req.params.id);
  res.status(204).end();
}
