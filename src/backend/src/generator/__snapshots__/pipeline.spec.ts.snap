    "content": "FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install --no-audit --no-fund
COPY . .
RUN npm run build

FROM node:22-alpine
# prisma cần openssl để chạy schema engine
RUN apk add --no-cache openssl
WORKDIR /app
ENV NODE_ENV=production
COPY package*.json ./
RUN npm install --omit=dev --no-audit --no-fund
COPY --from=build /app/dist ./dist
COPY prisma ./prisma
COPY prisma.config.ts ./
USER node
EXPOSE 3000
# Schema sinh ra chưa có thư mục migrations nên đồng bộ bằng db push (không tự xóa dữ liệu)
CMD ["sh", "-c", "npx prisma db push && exec node dist/server.js"]
