  {
    "content": "name: school-admin

services:
  db:
    image: postgres:16
    environment:
      POSTGRES_DB: \${DB_NAME:-school-admin}
      POSTGRES_USER: \${DB_USER:-app}
      POSTGRES_PASSWORD: \${DB_PASSWORD:?đặt DB_PASSWORD trong .env}
    ports:
      - '127.0.0.1:\${DB_PORT:-5432}:5432'
    volumes:
      - db_data:/var/lib/postgresql/data
    healthcheck:
      test:
        [
          'CMD-SHELL',
          'pg_isready -U \${DB_USER:-app} -d \${DB_NAME:-school-admin}',
        ]
      interval: 5s
      timeout: 5s
      retries: 10

  backend:
    build: ./backend
    environment:
      PORT: 3000
      DATABASE_URL: \${DATABASE_URL:-postgresql://\${DB_USER:-app}:\${DB_PASSWORD}@db:5432/\${DB_NAME:-school-admin}}
      JWT_SECRET: \${JWT_SECRET:?đặt JWT_SECRET trong .env}
      JWT_ACCESS_TTL: \${JWT_ACCESS_TTL:-15m}
      JWT_REFRESH_TTL: \${JWT_REFRESH_TTL:-7d}
      ADMIN_EMAIL: \${ADMIN_EMAIL:-}
      ADMIN_PASSWORD: \${ADMIN_PASSWORD:-}
      RATE_LIMIT_PER_MIN: \${RATE_LIMIT_PER_MIN:-100}
      CORS_ORIGIN: \${CORS_ORIGIN:-http://localhost:8080}
      TRUST_PROXY: '1'
    depends_on:
      db:
        condition: service_healthy
    healthcheck:
      test:
        ['CMD-SHELL', 'wget -qO- http://localhost:3000/api/health || exit 1']
      interval: 5s
      timeout: 5s
      retries: 20
      start_period: 20s

  frontend:
    build: ./frontend
    ports:
      - '\${FRONTEND_PORT:-8080}:80'
    depends_on:
      backend:
        condition: service_healthy

volumes:
  db_data:
