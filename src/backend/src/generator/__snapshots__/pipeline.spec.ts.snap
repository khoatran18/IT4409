import { HttpError } from '../../middleware/errorHandler';
import { parseSort, type ListQuery } from '../../lib/query';
import type { SupplierInput } from './supplier.schema';

const SORTABLE = [
  'id',
  'companyName',
  'active',
  'createdAt',
  'updatedAt',
] as const;

const SEARCHABLE = ['companyName'] as const;

export async function listSupplier({ page, pageSize, sort, q }: ListQuery) {
  const where = (
    q && SEARCHABLE.length > 0
      ? {
          OR: SEARCHABLE.map((field) => ({
            [field]: { contains: q, mode: 'insensitive' },
          })),
        }
      : {}
  ) as Prisma.SupplierWhereInput;
  const [total, data] = await Promise.all([
    prisma.supplier.count({ where }),
    prisma.supplier.findMany({
      where,
      orderBy: parseSort(sort, SORTABLE),
      skip: (page - 1) * pageSize,
      take: pageSize,
    }),
  ]);
  return { data, meta: { page, pageSize, total } };
}

export async function getSupplier(id: string) {
  const record = await prisma.supplier.findUnique({ where: { id } });
  if (!record) throw new HttpError(404, 'NOT_FOUND', 'Supplier không tồn tại');
