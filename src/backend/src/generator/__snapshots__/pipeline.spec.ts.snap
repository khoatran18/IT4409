  {
    "content": "import { z } from 'zod';

/** Dùng cho cả tạo mới và cập nhật; id, createdAt, updatedAt do server quản lý nên bị bỏ qua */
export const studentInputSchema = z.object({
  name: z.string().min(1).max(255),
  email: z.string().max(255).nullish(),
  age: z.number().nullish(),
});

export type StudentInput = z.infer<typeof studentInputSchema>;
",
    "path": "backend/src/modules/student/student.schema.ts",
  },
  {
    "content": "import { Prisma } from '../../generated/prisma/client';
import { prisma } from '../../lib/prisma';
import { HttpError } from '../../middleware/errorHandler';
import { parseSort, type ListQuery } from '../../lib/query';
import type { StudentInput } from './student.schema';

const SORTABLE = [
  'id',
  'name',
  'email',
  'age',
  'createdAt',
  'updatedAt',
] as const;

const SEARCHABLE = ['name', 'email'] as const;

export async function listStudent({ page, pageSize, sort, q }: ListQuery) {
  const where = (
    q && SEARCHABLE.length > 0
      ? {
          OR: SEARCHABLE.map((field) => ({
            [field]: { contains: q, mode: 'insensitive' },
          })),
        }
      : {}
  ) as Prisma.StudentWhereInput;
  const [total, data] = await Promise.all([
    prisma.student.count({ where }),
    prisma.student.findMany({
      where,
      orderBy: parseSort(sort, SORTABLE),
      skip: (page - 1) * pageSize,
      take: pageSize,
    }),
  ]);
  return { data, meta: { page, pageSize, total } };
}

export async function getStudent(id: string) {
  const record = await prisma.student.findUnique({ where: { id } });
  if (!record) throw new HttpError(404, 'NOT_FOUND', 'Student không tồn tại');
  return record;
}

export function createStudent(input: StudentInput) {
  return prisma.student.create({ data: input });
}

/** Cập nhật toàn bộ: field tùy chọn không gửi sẽ về null */
const CLEARED = {
  email: null,
  age: null,
};

export function updateStudent(id: string, input: StudentInput) {
  return prisma.student.update({
    where: { id },
    data: { ...CLEARED, ...input },
  });
}

export async function deleteStudent(id: string) {
  await prisma.student.delete({ where: { id } });
}
