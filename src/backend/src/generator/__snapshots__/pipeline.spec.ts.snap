  {
    "content": "import { useEffect, useState, type CSSProperties } from 'react';
import { Link, useNavigate, useParams } from 'react-router-dom';
import { studentApi } from '../../api/student.api';
import { errorMessage } from '../../api/errors';
import { useAuth } from '../../auth/AuthContext';
import { formatDateTime, formatValue } from '../../lib/fields';
import type { Student } from '../../types/student';

const ENTITY = 'Student';

const pageStyle: CSSProperties = { padding: 24, maxWidth: 640 };
const listStyle: CSSProperties = {
  display: 'grid',
  gridTemplateColumns: '160px 1fr',
  gap: 8,
};
const actionsStyle: CSSProperties = {
  display: 'flex',
  gap: 12,
  alignItems: 'center',
  marginTop: 16,
};

export default function StudentDetail() {
  const { id } = useParams();
  const navigate = useNavigate();
  const { can } = useAuth();
  const [record, setRecord] = useState<Student | null>(null);
  const [error, setError] = useState('');

  useEffect(() => {
    if (id === undefined) return;
    let cancelled = false;
    studentApi
      .get(id)
      .then((result) => {
        if (!cancelled) setRecord(result);
      })
      .catch((e: unknown) => {
        if (!cancelled) setError(errorMessage(e));
      });
    return () => {
      cancelled = true;
    };
  }, [id]);

  async function handleDelete() {
    if (!record || !window.confirm('Xóa bản ghi này?')) return;
    try {
      await studentApi.remove(record.id);
      navigate('/students');
    } catch (e) {
      setError(errorMessage(e));
    }
  }

  return (
    <main style={pageStyle}>
      <h1>Chi tiết Student</h1>
      {error && <p role="alert">{error}</p>}
      {!record && !error && <p>Đang tải...</p>}
      {record && (
        <dl style={listStyle}>
          <dt>name</dt>
          <dd>{formatValue(record.name, 'string')}</dd>
          <dt>email</dt>
          <dd>{formatValue(record.email, 'string')}</dd>
          <dt>age</dt>
          <dd>{formatValue(record.age, 'number')}</dd>
          <dt>createdAt</dt>
          <dd>{formatDateTime(record.createdAt)}</dd>
          <dt>updatedAt</dt>
          <dd>{formatDateTime(record.updatedAt)}</dd>
        </dl>
      )}
      <div style={actionsStyle}>
        <Link to="/students">Quay lại</Link>
        {record && can(ENTITY, 'update') && (
          <Link to={\`/students/\${record.id}/edit\`}>Sửa</Link>
        )}
        {record && can(ENTITY, 'delete') && (
          <button type="button" onClick={() => void handleDelete()}>
            Xóa
          </button>
        )}
      </div>
    </main>
  );
}
",
    "path": "frontend/src/pages/student/DetailPage.tsx",
  },
  {
    "content": "import { useEffect, useState, type CSSProperties, type FormEvent } from 'react';
import { Link, useNavigate, useParams } from 'react-router-dom';
import { studentApi } from '../../api/student.api';
import { parseApiError } from '../../api/errors';
import {
  initialValues,
  toPayload,
  validate,
  type FormValues,
} from '../../lib/fields';
import { studentFields, type StudentInput } from '../../types/student';

const pageStyle: CSSProperties = { padding: 24, maxWidth: 520 };
const formStyle: CSSProperties = { display: 'grid', gap: 12 };
const labelStyle: CSSProperties = { display: 'grid', gap: 4 };
const checkStyle: CSSProperties = {
  display: 'flex',
  gap: 8,
  alignItems: 'center',
};
const errorStyle: CSSProperties = { color: '#b91c1c', fontSize: 13 };
const actionsStyle: CSSProperties = {
  display: 'flex',
  gap: 12,
  alignItems: 'center',
};

export default function StudentForm() {
  const { id } = useParams();
  const navigate = useNavigate();
  const editing = id !== undefined;
  const [values, setValues] = useState<FormValues>(() =>
    initialValues(studentFields),
  );
  const [errors, setErrors] = useState<Record<string, string>>({});
  const [formError, setFormError] = useState('');
  const [loading, setLoading] = useState(editing);
  const [saving, setSaving] = useState(false);

  useEffect(() => {
    if (id === undefined) return;
    let cancelled = false;
    studentApi
      .get(id)
      .then((record) => {
        if (!cancelled) setValues(initialValues(studentFields, { ...record }));
      })
      .catch((e: unknown) => {
        if (!cancelled) setFormError(parseApiError(e).message);
      })
      .finally(() => {
        if (!cancelled) setLoading(false);
      });
    return () => {
      cancelled = true;
    };
  }, [id]);

  function setValue(name: string, value: string | boolean) {
    setValues((current) => ({ ...current, [name]: value }));
    setErrors((current) => ({ ...current, [name]: '' }));
  }

  async function handleSubmit(e: FormEvent) {
    e.preventDefault();
    setFormError('');
    const clientErrors = validate(studentFields, values);
    setErrors(clientErrors);
    if (Object.keys(clientErrors).length > 0) return;

    const payload = toPayload(studentFields, values) as StudentInput;
    setSaving(true);
    try {
      if (id === undefined) await studentApi.create(payload);
      else await studentApi.update(id, payload);
      navigate('/students');
    } catch (err) {
      const info = parseApiError(err);
      setErrors(info.fields);
      setFormError(Object.keys(info.fields).length > 0 ? '' : info.message);
    } finally {
      setSaving(false);
    }
  }

  if (loading) return <main style={pageStyle}>Đang tải...</main>;

  return (
    <main style={pageStyle}>
      <h1>{editing ? 'Sửa' : 'Thêm'} Student</h1>
      <form style={formStyle} onSubmit={handleSubmit} noValidate>
        <label style={labelStyle}>
          <span>name *</span>
          <input
            type="text"
            name="name"
            value={String(values['name'])}
            onChange={(e) => setValue('name', e.target.value)}
          />
          {errors['name'] && <span style={errorStyle}>{errors['name']}</span>}
        </label>
        <label style={labelStyle}>
          <span>email</span>
          <input
            type="text"
            name="email"
            value={String(values['email'])}
            onChange={(e) => setValue('email', e.target.value)}
          />
          {errors['email'] && <span style={errorStyle}>{errors['email']}</span>}
        </label>
        <label style={labelStyle}>
          <span>age</span>
          <input
            type="number"
            step="any"
            name="age"
            value={String(values['age'])}
            onChange={(e) => setValue('age', e.target.value)}
          />
          {errors['age'] && <span style={errorStyle}>{errors['age']}</span>}
        </label>
        {formError && (
          <span role="alert" style={errorStyle}>
            {formError}
          </span>
        )}
        <div style={actionsStyle}>
          <button type="submit" disabled={saving}>
            {saving ? 'Đang lưu...' : 'Lưu'}
          </button>
          <Link to="/students">Hủy</Link>
        </div>
      </form>
    </main>
  );
}
",
    "path": "frontend/src/pages/student/FormPage.tsx",
  },
  {
    "content": "import { useEffect, useState, type CSSProperties, type FormEvent } from 'react';
import { Link } from 'react-router-dom';
import { studentApi } from '../../api/student.api';
import { errorMessage } from '../../api/errors';
import type { ListMeta } from '../../api/types';
import { useAuth } from '../../auth/AuthContext';
import { formatValue } from '../../lib/fields';
import type { Student } from '../../types/student';

const ENTITY = 'Student';
const PAGE_SIZE = 10;

const pageStyle: CSSProperties = { padding: 24 };
const barStyle: CSSProperties = {
  display: 'flex',
  gap: 8,
  alignItems: 'center',
  marginBottom: 16,
};
const tableStyle: CSSProperties = { width: '100%', borderCollapse: 'collapse' };
const cellStyle: CSSProperties = {
  padding: '6px 8px',
  borderBottom: '1px solid #ddd',
  textAlign: 'left',
};
const sortableStyle: CSSProperties = {
  ...cellStyle,
  cursor: 'pointer',
  userSelect: 'none',
};
const actionsStyle: CSSProperties = { ...cellStyle, display: 'flex', gap: 8 };
const pagerStyle: CSSProperties = {
  display: 'flex',
  gap: 8,
  alignItems: 'center',
  marginTop: 16,
};

export default function StudentList() {
  const { can } = useAuth();
  const [rows, setRows] = useState<Student[]>([]);
  const [meta, setMeta] = useState<ListMeta>({
    page: 1,
    pageSize: PAGE_SIZE,
    total: 0,
  });
  const [page, setPage] = useState(1);
  const [search, setSearch] = useState('');
  const [q, setQ] = useState('');
  const [sort, setSort] = useState('');
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');
  const [reloadKey, setReloadKey] = useState(0);

  useEffect(() => {
    let cancelled = false;
    setLoading(true);
    studentApi
      .list({
        page,
        pageSize: PAGE_SIZE,
        q: q || undefined,
        sort: sort || undefined,
      })
      .then((result) => {
        if (cancelled) return;
        setRows(result.data);
        setMeta(result.meta);
        setError('');
      })
      .catch((e: unknown) => {
        if (!cancelled) setError(errorMessage(e));
      })
      .finally(() => {
        if (!cancelled) setLoading(false);
      });
    return () => {
      cancelled = true;
    };
  }, [page, q, sort, reloadKey]);

  function handleSearch(e: FormEvent) {
    e.preventDefault();
    setPage(1);
    setQ(search.trim());
  }

  function toggleSort(name: string) {
    setPage(1);
    setSort((current) =>
      current === \`\${name}:asc\` ? \`\${name}:desc\` : \`\${name}:asc\`,
    );
  }

  function sortMark(name: string): string {
    if (sort === \`\${name}:asc\`) return ' ▲';
    return sort === \`\${name}:desc\` ? ' ▼' : '';
  }

  async function handleDelete(row: Student) {
    if (!window.confirm('Xóa bản ghi này?')) return;
    try {
      await studentApi.remove(row.id);
      if (rows.length === 1 && page > 1) setPage(page - 1);
      else setReloadKey((key) => key + 1);
    } catch (e) {
      setError(errorMessage(e));
    }
  }

  const totalPages = Math.max(1, Math.ceil(meta.total / meta.pageSize));
  const canUpdate = can(ENTITY, 'update');
  const canDelete = can(ENTITY, 'delete');

  return (
    <main style={pageStyle}>
      <h1>Danh sách Student</h1>
      <div style={barStyle}>
        <form onSubmit={handleSearch}>
          <input
            type="search"
            placeholder="Tìm kiếm"
            value={search}
            onChange={(e) => setSearch(e.target.value)}
          />{' '}
          <button type="submit">Tìm</button>
        </form>
        {can(ENTITY, 'create') && <Link to="/students/new">Thêm mới</Link>}
      </div>
      {error && <p role="alert">{error}</p>}
      <table style={tableStyle}>
        <thead>
          <tr>
            <th style={sortableStyle} onClick={() => toggleSort('name')}>
              name
              {sortMark('name')}
            </th>
            <th style={sortableStyle} onClick={() => toggleSort('email')}>
              email
              {sortMark('email')}
            </th>
            <th style={sortableStyle} onClick={() => toggleSort('age')}>
              age
              {sortMark('age')}
            </th>
            {(canUpdate || canDelete) && <th style={cellStyle} />}
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr key={row.id}>
              <td style={cellStyle}>
                <Link to={\`/students/\${row.id}\`}>
                  {formatValue(row.name, 'string') || row.id}
                </Link>
              </td>
              <td style={cellStyle}>{formatValue(row.email, 'string')}</td>
              <td style={cellStyle}>{formatValue(row.age, 'number')}</td>
              {(canUpdate || canDelete) && (
                <td style={actionsStyle}>
                  {canUpdate && (
                    <Link to={\`/students/\${row.id}/edit\`}>Sửa</Link>
                  )}
                  {canDelete && (
                    <button
                      type="button"
                      onClick={() => void handleDelete(row)}
                    >
                      Xóa
                    </button>
                  )}
                </td>
              )}
            </tr>
          ))}
        </tbody>
      </table>
      {!loading && rows.length === 0 && !error && <p>Chưa có dữ liệu.</p>}
      {loading && <p>Đang tải...</p>}
      <div style={pagerStyle}>
        <button
          type="button"
          disabled={page <= 1}
          onClick={() => setPage(page - 1)}
        >
          Trước
        </button>
        <span>
          Trang {meta.page} / {totalPages} ({meta.total} bản ghi)
        </span>
        <button
          type="button"
          disabled={page >= totalPages}
          onClick={() => setPage(page + 1)}
        >
          Sau
        </button>
      </div>
    </main>
  );
}
",
    "path": "frontend/src/pages/student/ListPage.tsx",
  },
  {
    "content": "/** Route do trang entity (danh sách, thêm, chi tiết, sửa) chiếm; page tùy biến trùng route này bị bỏ qua. */
export const reservedRoutes: string[] = [
  '/students',
  '/students/new',
  '/students/:id',
  '/students/:id/edit',
];

export function isReserved(route: string): boolean {
  return reservedRoutes.includes(route);
}
",
    "path": "frontend/src/routes.ts",
  },
  {
    "content": "import type { FieldMeta } from '../lib/fields';

export interface Student {
  id: string;
  name: string;
  email?: string | null;
  age?: number | null;
  createdAt: string;
  updatedAt: string;
}

/** Body tạo/sửa: server tự quản lý id, createdAt, updatedAt */
export type StudentInput = Omit<Student, 'id' | 'createdAt' | 'updatedAt'>;

export const studentFields: FieldMeta[] = [
  { name: 'name', type: 'string', required: true, unique: false, options: [] },
  { name: 'email', type: 'string', required: false, unique: true, options: [] },
  { name: 'age', type: 'number', required: false, unique: false, options: [] },
];
",
    "path": "frontend/src/types/student.ts",
  },
  {
    "content": "{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true
  },
  "include": ["src"]
}
",
    "path": "frontend/tsconfig.json",
  },
  {
    "content": "import react from '@vitejs/plugin-react';
import { defineConfig } from 'vite';

export default defineConfig({
  plugins: [react()],
  server: {
    proxy: { '/api': 'http://localhost:3000' },
  },
});
",
    "path": "frontend/vite.config.ts",
  },
]
`;
