    "content": "import { Router } from 'express';
import { validateBody } from '../../middleware/validate';
import * as controller from './category.controller';
import { categoryInputSchema } from './category.schema';

export const categoryRouter = Router();

// Tuần 4: thêm authorize('Category', 'R' | 'C' | 'U' | 'D') trước từng handler.
categoryRouter.get('/', controller.list);
categoryRouter.get('/:id', controller.get);
categoryRouter.post('/', validateBody(categoryInputSchema), controller.create);
categoryRouter.put(
