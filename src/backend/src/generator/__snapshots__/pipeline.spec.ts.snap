    "content": "@echo off
powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0start.ps1"
set EXITCODE=%ERRORLEVEL%
pause
exit /b %EXITCODE%
",
    "path": "start.bat",
  },
  {
    "content": "$ErrorActionPreference = 'Stop'
Set-Location -LiteralPath $PSScriptRoot

function Fail([string]$message) {
    Write-Host "Loi: $message" -ForegroundColor Red
    exit 1
}

function Test-Docker([string]$arguments) {
    cmd /c "docker $arguments >nul 2>&1"
    return ($LASTEXITCODE -eq 0)
}

function Read-Env([string]$name) {
    $line = Get-Content -LiteralPath .env | Where-Object { $_ -match "^$name=" } | Select-Object -First 1
    if (-not $line) { return '' }
    return (($line -replace "^$name=", '') -replace "['""]", '').Trim()
}

if (-not (Get-Command docker -ErrorAction SilentlyContinue)) {
    Fail 'Chua cai Docker. Xem https://docs.docker.com/get-docker/ roi chay lai.'
}
if (-not (Test-Docker 'compose version')) {
    Fail "Khong co 'docker compose'. Cai Docker Compose v2 roi chay lai."
}
if (-not (Test-Docker 'info')) {
    Fail 'Docker chua chay. Hay khoi dong Docker Desktop roi chay lai.'
}

if (Test-Path -LiteralPath .env) {
    Write-Host 'Giu nguyen .env hien co.'
} else {
    Copy-Item -LiteralPath .env.example -Destination .env
    Write-Host 'Da tao .env tu .env.example.'
}

# docker compose ghi tien trinh ra stderr; khong de PowerShell coi do la loi
$ErrorActionPreference = 'Continue'
docker compose up -d --build --wait
$exitCode = $LASTEXITCODE
$ErrorActionPreference = 'Stop'

if ($exitCode -ne 0) {
    Write-Host ''
    Write-Host 'Khoi dong that bai. 30 dong log cuoi:' -ForegroundColor Red
    $ErrorActionPreference = 'Continue'
    docker compose logs --tail 30
    $ErrorActionPreference = 'Stop'
    Write-Host ''
    Write-Host 'Nguyen nhan hay gap: cong bi chiem. Doi FRONTEND_PORT hoac DB_PORT trong .env roi chay lai.'
    exit 1
}

$port = Read-Env 'FRONTEND_PORT'
if (-not $port) { $port = '8080' }
$admin = Read-Env 'ADMIN_EMAIL'
Write-Host ''
Write-Host "Ung dung da chay tai http://localhost:$port"
Write-Host "Tai khoan admin: $admin (hay doi mat khau sau lan dang nhap dau)"
",
    "path": "start.ps1",
  },
  {
    "content": "#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "\${BASH_SOURCE[0]}")"

fail() {
  echo "Lỗi: $*" >&2
  exit 1
}

command -v docker >/dev/null 2>&1 ||
  fail "Chưa cài Docker. Xem https://docs.docker.com/get-docker/ rồi chạy lại."
docker compose version >/dev/null 2>&1 ||
  fail "Không có 'docker compose'. Cài Docker Compose v2 rồi chạy lại."
docker info >/dev/null 2>&1 ||
  fail "Docker chưa chạy. Hãy khởi động Docker rồi chạy lại."

if [ -f .env ]; then
  echo "Giữ nguyên .env hiện có."
else
  cp .env.example .env
  echo "Đã tạo .env từ .env.example."
fi

read_env() {
  grep -E "^$1=" .env | head -n 1 | cut -d= -f2- | tr -d "'\\"\\r" || true
}

if ! docker compose up -d --build --wait; then
  echo >&2
  echo "Khởi động thất bại. 30 dòng log cuối:" >&2
  docker compose logs --tail 30 >&2 || true
  echo >&2
  echo "Nguyên nhân hay gặp: cổng bị chiếm. Đổi FRONTEND_PORT hoặc DB_PORT trong .env rồi chạy lại." >&2
  exit 1
fi

port="$(read_env FRONTEND_PORT)"
admin="$(read_env ADMIN_EMAIL)"
echo
echo "Ứng dụng đã chạy tại http://localhost:\${port:-8080}"
echo "Tài khoản admin: \${admin:-xem ADMIN_EMAIL trong .env} (hãy đổi mật khẩu sau lần đăng nhập đầu)"
",
    "path": "start.sh",
  },
  {
    "content": "@echo off
powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0stop.ps1" %*
set EXITCODE=%ERRORLEVEL%
pause
exit /b %EXITCODE%
",
    "path": "stop.bat",
  },
  {
    "content": "$ErrorActionPreference = 'Stop'
Set-Location -LiteralPath $PSScriptRoot
$purge = ($args -contains '--purge') -or ($args -contains '-purge')

# docker compose ghi tien trinh ra stderr; khong de PowerShell coi do la loi
$ErrorActionPreference = 'Continue'
if ($purge) {
    $answer = Read-Host "Xoa ca du lieu (database)? Khong the khoi phuc. Go 'yes' de xac nhan"
    if ($answer -ne 'yes') {
        Write-Host 'Da huy.'
        exit 0
    }
    docker compose down -v
    Write-Host 'Da dung va xoa du lieu.'
} else {
    docker compose down
    Write-Host "Da dung. Du lieu duoc giu lai; dung '.\\stop.ps1 --purge' de xoa."
}
exit $LASTEXITCODE
",
    "path": "stop.ps1",
  },
  {
    "content": "#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "\${BASH_SOURCE[0]}")"

if [ "\${1:-}" = "--purge" ]; then
  read -r -p "Xóa cả dữ liệu (database)? Không thể khôi phục. Gõ 'yes' để xác nhận: " answer
  if [ "$answer" != "yes" ]; then
    echo "Đã hủy."
    exit 0
  fi
  docker compose down -v
  echo "Đã dừng và xóa dữ liệu."
else
  docker compose down
  echo "Đã dừng. Dữ liệu được giữ lại; dùng './stop.sh --purge' để xóa."
fi
",
    "path": "stop.sh",
  },
]
`;

