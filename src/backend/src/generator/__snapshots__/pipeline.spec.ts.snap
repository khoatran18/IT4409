  {
    "content": "import { Prisma } from '../../generated/prisma/client';
import { prisma } from '../../lib/prisma';
import { HttpError } from '../../middleware/errorHandler';
import { parseSort, type ListQuery } from '../../lib/query';
import type { ProductInput } from './product.schema';

const SORTABLE = [
  'id',
  'name',
  'sku',
  'description',
  'price',
  'quantity',
  'category',
  'inStock',
  'releasedAt',
  'createdAt',
  'updatedAt',
] as const;

const SEARCHABLE = ['name', 'sku', 'description'] as const;

export async function listProduct({ page, pageSize, sort, q }: ListQuery) {
  const where = (
    q && SEARCHABLE.length > 0
      ? {
          OR: SEARCHABLE.map((field) => ({
            [field]: { contains: q, mode: 'insensitive' },
          })),
        }
      : {}
  ) as Prisma.ProductWhereInput;
  const [total, data] = await Promise.all([
    prisma.product.count({ where }),
    prisma.product.findMany({
      where,
      orderBy: parseSort(sort, SORTABLE),
      skip: (page - 1) * pageSize,
      take: pageSize,
    }),
  ]);
  return { data, meta: { page, pageSize, total } };
}

export async function getProduct(id: string) {
  const record = await prisma.product.findUnique({ where: { id } });
  if (!record) throw new HttpError(404, 'NOT_FOUND', 'Product không tồn tại');
  return record;
}

export function createProduct(input: ProductInput) {
  return prisma.product.create({ data: input });
}

/** Cập nhật toàn bộ: field tùy chọn không gửi sẽ về null */
const CLEARED = {
  description: null,
  category: null,
  inStock: null,
  releasedAt: null,
};

export function updateProduct(id: string, input: ProductInput) {
  return prisma.product.update({
    where: { id },
    data: { ...CLEARED, ...input },
  });
}

export async function deleteProduct(id: string) {
  await prisma.product.delete({ where: { id } });
}
