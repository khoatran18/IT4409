  {
    "content": "import type { ReactNode } from 'react';
import { Navigate, useLocation } from 'react-router-dom';
import { useAuth, type EntityAction } from './AuthContext';

const style = { padding: 24 };

interface ProtectedRouteProps {
  /** Rỗng hoặc bỏ trống: chỉ cần đăng nhập */
  requireRole?: string[];
  /** Trang entity: cần quyền \`action\` trên \`entity\` */
  entity?: string;
  action?: EntityAction;
  children: ReactNode;
}

export default function ProtectedRoute({
  requireRole = [],
  entity,
  action = 'read',
  children,
}: ProtectedRouteProps) {
  const { user, loading, can } = useAuth();
  const location = useLocation();

  if (loading) return null;
  if (!user) {
    const state = { from: location.pathname };
    return <Navigate to="/login" state={state} replace />;
  }
  const denied =
    (requireRole.length > 0 && !requireRole.includes(user.role)) ||
    (entity !== undefined && !can(entity, action));
  if (denied) {
    return (
      <main style={style}>
        <h1>403</h1>
        <p>Bạn không có quyền truy cập trang này.</p>
      </main>
    );
  }
  return <>{children}</>;
}
",
    "path": "frontend/src/auth/ProtectedRoute.tsx",
  },
  {
    "content": "import type { CSSProperties } from 'react';
import { NavLink, Outlet } from 'react-router-dom';
import { useAuth } from '../auth/AuthContext';
import { isReserved } from '../routes';

interface MenuItem {
  title: string;
  route: string;
  requireRole: string[];
  /** Mục của trang entity: hiện khi role có quyền đọc entity */
  entity?: string;
}

const entityMenu: MenuItem[] = [
  {
    title: 'Danh sách Student',
    route: '/students',
    requireRole: [],
    entity: 'Student',
  },
];

const pageMenu: MenuItem[] = [
  { title: 'Sinh viên', route: '/students', requireRole: ['admin', 'user'] },
].filter((item) => !isReserved(item.route));

const menu: MenuItem[] = [...entityMenu, ...pageMenu];

const shellStyle: CSSProperties = {
  display: 'grid',
  gridTemplateColumns: '220px 1fr',
  minHeight: '100vh',
};
const sidebarStyle: CSSProperties = {
  display: 'grid',
  alignContent: 'start',
  gap: 8,
  padding: 16,
  borderRight: '1px solid #ddd',
};
const headerStyle: CSSProperties = {
  display: 'flex',
  justifyContent: 'flex-end',
  alignItems: 'center',
  gap: 12,
  padding: 12,
  borderBottom: '1px solid #ddd',
};

export default function AppLayout() {
  const { user, can, logout } = useAuth();
  const items = menu.filter((item) => {
    if (item.entity) return can(item.entity, 'read');
    return (
      item.requireRole.length === 0 ||
      (user !== null && item.requireRole.includes(user.role))
    );
  });

  return (
    <div style={shellStyle}>
      <nav style={sidebarStyle}>
        <strong>school-admin</strong>
        {items.map((item) => (
          <NavLink key={item.route} to={item.route}>
            {item.title}
          </NavLink>
        ))}
      </nav>
      <div>
        <header style={headerStyle}>
          <span>{user?.email}</span>
          <button type="button" onClick={logout}>
            Đăng xuất
          </button>
        </header>
        <Outlet />
      </div>
    </div>
  );
}
",
    "path": "frontend/src/layout/AppLayout.tsx",
  },
  {
    "content": "export type FieldType =
  'string' | 'text' | 'number' | 'boolean' | 'date' | 'enum';

export interface FieldMeta {
  name: string;
  type: FieldType;
  required: boolean;
  unique: boolean;
  options: string[];
  default?: string | number | boolean;
}

/** Giá trị form: checkbox là boolean, còn lại là chuỗi nhập vào */
export type FormValues = Record<string, string | boolean>;

export function initialValues(
  fields: FieldMeta[],
  record?: Record<string, unknown>,
): FormValues {
  const values: FormValues = {};
  for (const field of fields) {
    const source = record ? record[field.name] : field.default;
    if (field.type === 'boolean') values[field.name] = Boolean(source);
    else if (source === undefined || source === null) values[field.name] = '';
    else
      values[field.name] =
        field.type === 'date' ? String(source).slice(0, 10) : String(source);
  }
  return values;
}

export function validate(
  fields: FieldMeta[],
  values: FormValues,
): Record<string, string> {
  const errors: Record<string, string> = {};
  for (const field of fields) {
    if (field.type === 'boolean') continue;
    const value = String(values[field.name] ?? '').trim();
    if (value === '') {
      if (field.required) errors[field.name] = 'Bắt buộc nhập';
    } else if (field.type === 'number' && Number.isNaN(Number(value))) {
      errors[field.name] = 'Phải là số';
    } else if (field.type === 'enum' && !field.options.includes(value)) {
      errors[field.name] = 'Giá trị không hợp lệ';
    }
  }
  return errors;
}

/** Chuyển giá trị form thành body gửi API; field tùy chọn để trống gửi null */
export function toPayload(
  fields: FieldMeta[],
  values: FormValues,
): Record<string, unknown> {
  const payload: Record<string, unknown> = {};
  for (const field of fields) {
    const value = values[field.name];
    if (field.type === 'boolean') payload[field.name] = Boolean(value);
    else if (String(value).trim() === '') payload[field.name] = null;
    else payload[field.name] = field.type === 'number' ? Number(value) : value;
  }
  return payload;
}

export function formatValue(value: unknown, type: FieldType): string {
  if (value === undefined || value === null || value === '') return '';
  if (type === 'boolean') return value ? 'Có' : 'Không';
  if (type === 'date')
    return new Date(String(value)).toLocaleDateString('vi-VN');
  return String(value);
}

export function formatDateTime(value: unknown): string {
  return value ? new Date(String(value)).toLocaleString('vi-VN') : '';
}
