  {
    "content": "import type { ReactElement } from 'react';
import { Navigate, Route, Routes } from 'react-router-dom';
import { AuthProvider } from './auth/AuthContext';
import LoginPage from './auth/LoginPage';
import ProtectedRoute from './auth/ProtectedRoute';
import AppLayout from './layout/AppLayout';
import PagePlaceholder from './pages/PagePlaceholder';
import { isReserved } from './routes';
import StudentList from './pages/student/ListPage';
import StudentForm from './pages/student/FormPage';
import StudentDetail from './pages/student/DetailPage';

function StudentsPage() {
  return <PagePlaceholder title="Sinh viên" />;
}

interface CustomPage {
  route: string;
  requireRole: string[];
  element: ReactElement;
}

const customPages: CustomPage[] = [
  {
    route: '/students',
    requireRole: ['admin', 'user'],
    element: <StudentsPage />,
  },
].filter((page) => !isReserved(page.route));

export default function App() {
  return (
    <AuthProvider>
      <Routes>
        <Route path="/login" element={<LoginPage />} />
        <Route
          element={
            <ProtectedRoute>
              <AppLayout />
            </ProtectedRoute>
          }
        >
          <Route path="/" element={<Navigate to="/students" replace />} />
          <Route
            path="/students"
            element={
              <ProtectedRoute entity="Student" action="read">
                <StudentList />
              </ProtectedRoute>
            }
          />
          <Route
            path="/students/new"
            element={
              <ProtectedRoute entity="Student" action="create">
                <StudentForm />
              </ProtectedRoute>
            }
          />
          <Route
            path="/students/:id"
            element={
              <ProtectedRoute entity="Student" action="read">
                <StudentDetail />
              </ProtectedRoute>
            }
          />
          <Route
            path="/students/:id/edit"
            element={
              <ProtectedRoute entity="Student" action="update">
                <StudentForm />
              </ProtectedRoute>
            }
          />
          {customPages.map((page) => (
            <Route
              key={page.route}
              path={page.route}
              element={
                <ProtectedRoute requireRole={page.requireRole}>
                  {page.element}
                </ProtectedRoute>
              }
            />
          ))}
          <Route path="*" element={<PagePlaceholder title="404" />} />
        </Route>
      </Routes>
    </AuthProvider>
  );
}
",
    "path": "frontend/src/App.tsx",
  },
  {
    "content": "import axios from 'axios';

const TOKEN_KEY = 'accessToken';

export function getToken(): string | null {
  return localStorage.getItem(TOKEN_KEY);
}

export function setToken(token: string): void {
  localStorage.setItem(TOKEN_KEY, token);
}

export function clearToken(): void {
  localStorage.removeItem(TOKEN_KEY);
}

let unauthorizedHandler: () => void = () => {};

/** AuthContext đăng ký hàm này để đăng xuất khi server trả 401. */
export function onUnauthorized(handler: () => void): void {
  unauthorizedHandler = handler;
}

export const api = axios.create({ baseURL: '/api' });

api.interceptors.request.use((config) => {
  const token = getToken();
  if (token) config.headers.Authorization = \`Bearer \${token}\`;
  return config;
});

api.interceptors.response.use(
  (response) => response,
  (error: unknown) => {
    const isLogin =
      axios.isAxiosError(error) && error.config?.url === '/auth/login';
    if (
      axios.isAxiosError(error) &&
      error.response?.status === 401 &&
      !isLogin
    ) {
      clearToken();
      unauthorizedHandler();
    }
    return Promise.reject(error);
  },
);
",
    "path": "frontend/src/api/client.ts",
  },
  {
    "content": "import axios from 'axios';

export interface ApiErrorInfo {
  status?: number;
  code?: string;
  message: string;
  /** Lỗi theo field, lấy từ \`error.details\` (422 và 409) */
  fields: Record<string, string>;
}

interface ErrorBody {
  error?: {
    code?: string;
    message?: string;
    details?: Array<{ path?: string; message?: string }>;
  };
}

export function parseApiError(error: unknown): ApiErrorInfo {
  if (!axios.isAxiosError<ErrorBody>(error)) {
    return { message: 'Đã xảy ra lỗi không xác định', fields: {} };
  }
  const body = error.response?.data?.error;
  if (!error.response)
    return { message: 'Không kết nối được máy chủ', fields: {} };

  const fields: Record<string, string> = {};
  for (const detail of body?.details ?? []) {
    if (detail.path && detail.message) fields[detail.path] = detail.message;
  }
  return {
    status: error.response.status,
    code: body?.code,
    message: body?.message ?? \`Lỗi \${error.response.status}\`,
    fields,
  };
}

export function errorMessage(error: unknown): string {
  return parseApiError(error).message;
}
",
    "path": "frontend/src/api/errors.ts",
