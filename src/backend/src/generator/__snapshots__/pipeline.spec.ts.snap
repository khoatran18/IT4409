  {
    "content": "import type { Request, Response } from 'express';
import { parseListQuery } from '../../lib/query';
import * as service from './student.service';

export async function list(req: Request, res: Response) {
  res.json(await service.listStudent(parseListQuery(req.query)));
}

export async function get(req: Request<{ id: string }>, res: Response) {
  res.json({ data: await service.getStudent(req.params.id) });
}

export async function create(req: Request, res: Response) {
  res.status(201).json({ data: await service.createStudent(req.body) });
}

export async function update(req: Request<{ id: string }>, res: Response) {
  res.json({ data: await service.updateStudent(req.params.id, req.body) });
}

export async function remove(req: Request<{ id: string }>, res: Response) {
  await service.deleteStudent(req.params.id);
  res.status(204).end();
}
",
