  {
    "content": "import { Prisma } from '../../generated/prisma/client';
import { prisma } from '../../lib/prisma';
import { HttpError } from '../../middleware/errorHandler';
import { parseSort, type ListQuery } from '../../lib/query';
import type { CategoryInput } from './category.schema';

const SORTABLE = ['id', 'title', 'createdAt', 'updatedAt'] as const;

const SEARCHABLE = ['title'] as const;

export async function listCategory({ page, pageSize, sort, q }: ListQuery) {
  const where = (
    q && SEARCHABLE.length > 0
      ? {
          OR: SEARCHABLE.map((field) => ({
            [field]: { contains: q, mode: 'insensitive' },
          })),
        }
      : {}
  ) as Prisma.CategoryWhereInput;
  const [total, data] = await Promise.all([
    prisma.category.count({ where }),
    prisma.category.findMany({
      where,
      orderBy: parseSort(sort, SORTABLE),
      skip: (page - 1) * pageSize,
      take: pageSize,
    }),
  ]);
  return { data, meta: { page, pageSize, total } };
}

export async function getCategory(id: string) {
  const record = await prisma.category.findUnique({ where: { id } });
  if (!record) throw new HttpError(404, 'NOT_FOUND', 'Category không tồn tại');
  return record;
}

export function createCategory(input: CategoryInput) {
  return prisma.category.create({ data: input });
}

/** Cập nhật toàn bộ: field tùy chọn không gửi sẽ về null */
const CLEARED = {};

export function updateCategory(id: string, input: CategoryInput) {
  return prisma.category.update({
    where: { id },
    data: { ...CLEARED, ...input },
  });
}

export async function deleteCategory(id: string) {
  await prisma.category.delete({ where: { id } });
}
