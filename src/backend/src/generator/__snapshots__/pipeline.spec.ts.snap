    "content": "import { Router } from 'express';
import { validateBody } from '../../middleware/validate';
import * as controller from './student.controller';
import { studentInputSchema } from './student.schema';

export const studentRouter = Router();

// Tuần 4: thêm authorize('Student', 'R' | 'C' | 'U' | 'D') trước từng handler.
studentRouter.get('/', controller.list);
studentRouter.get('/:id', controller.get);
studentRouter.post('/', validateBody(studentInputSchema), controller.create);
studentRouter.put('/:id', validateBody(studentInputSchema), controller.update);
studentRouter.delete('/:id', controller.remove);
",
    "path": "backend/src/modules/student/student.routes.ts",
