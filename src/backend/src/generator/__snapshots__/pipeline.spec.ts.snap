  {
    "content": "import { z } from 'zod';
import { HttpError } from '../middleware/errorHandler';

export const listQuerySchema = z.object({
  page: z.coerce.number().int().min(1).default(1),
  pageSize: z.coerce.number().int().min(1).max(100).default(10),
  sort: z.string().optional(),
  q: z.string().trim().optional(),
});

export type ListQuery = z.infer<typeof listQuerySchema>;

export function parseListQuery(query: unknown): ListQuery {
  const result = listQuerySchema.safeParse(query);
  if (!result.success) {
    throw new HttpError(
      422,
      'VALIDATION_ERROR',
      'Tham số truy vấn không hợp lệ',
      result.error.issues.map((issue) => ({
        path: issue.path.join('.'),
        message: issue.message,
      })),
    );
  }
  return result.data;
}

/** \`name:asc,age:desc\` thành orderBy của Prisma; field lạ trả 422 */
export function parseSort(
  sort: string | undefined,
  allowed: readonly string[],
): Array<Record<string, 'asc' | 'desc'>> {
  if (!sort) return [{ createdAt: 'desc' }, { id: 'asc' }];
  return sort.split(',').map((part) => {
    const [field, direction = 'asc'] = part.split(':');
    if (
      !allowed.includes(field) ||
      (direction !== 'asc' && direction !== 'desc')
    ) {
      throw new HttpError(
        422,
        'VALIDATION_ERROR',
        'Tham số sort không hợp lệ',
        [
          {
            path: 'sort',
            message: \`"\${part}" không hợp lệ, field hợp lệ: \${allowed.join(', ')}\`,
          },
        ],
      );
    }
    return { [field]: direction };
  });
}
",
    "path": "backend/src/lib/query.ts",
  },
  {
    "content": "import type { NextFunction, Request, Response } from 'express';
import { Prisma } from '../generated/prisma/client';

export interface ErrorDetail {
  path: string;
  message: string;
}

export class HttpError extends Error {
  constructor(
    readonly status: number,
    readonly code: string,
    message: string,
    readonly details?: ErrorDetail[],
  ) {
    super(message);
  }
}

function send(
  res: Response,
  status: number,
  code: string,
  message: string,
  details?: ErrorDetail[],
) {
  res
    .status(status)
    .json({ error: { code, message, ...(details ? { details } : {}) } });
}

interface UniqueViolationMeta {
  target?: string[];
  driverAdapterError?: {
    cause?: {
      table?: string;
      constraint?: { fields?: string[]; index?: string };
    };
  };
}

/** Tên field vi phạm unique; với adapter pg chỉ có tên index dạng \`<bảng>_<field>_key\` */
function conflictFields(meta: UniqueViolationMeta | undefined): string[] {
  const cause = meta?.driverAdapterError?.cause;
  if (meta?.target) return meta.target;
  if (cause?.constraint?.fields) return cause.constraint.fields;
  const { index } = cause?.constraint ?? {};
  const prefix = \`\${cause?.table}_\`;
  if (index?.startsWith(prefix) && index.endsWith('_key')) {
    return [index.slice(prefix.length, -'_key'.length)];
  }
  return [];
}

export function notFound(_req: Request, res: Response) {
  send(res, 404, 'NOT_FOUND', 'Không tìm thấy đường dẫn');
}

export function errorHandler(
  err: unknown,
  req: Request,
  res: Response,
  _next: NextFunction,
) {
  if (err instanceof HttpError) {
    return send(res, err.status, err.code, err.message, err.details);
  }
  if (err instanceof Prisma.PrismaClientKnownRequestError) {
    if (err.code === 'P2002') {
      return send(
        res,
        409,
        'CONFLICT',
        'Giá trị đã tồn tại',
        conflictFields(err.meta as UniqueViolationMeta | undefined).map(
          (path) => ({
            path,
            message: 'Giá trị đã tồn tại',
          }),
        ),
      );
    }
    if (err.code === 'P2025') {
      return send(res, 404, 'NOT_FOUND', 'Không tìm thấy bản ghi');
    }
  }
  const status = (err as { status?: number } | null)?.status;
  if (status === 400 || status === 413) {
    return send(res, 400, 'BAD_REQUEST', 'Request sai cấu trúc');
  }
  console.error(\`\${req.id} \${err instanceof Error ? err.stack : String(err)}\`);
  send(res, 500, 'INTERNAL_ERROR', 'Lỗi máy chủ');
}
",
    "path": "backend/src/middleware/errorHandler.ts",
  },
  {
    "content": "import { randomUUID } from 'node:crypto';
import type { NextFunction, Request, Response } from 'express';

declare module 'express-serve-static-core' {
  interface Request {
    id?: string;
  }
}

export function logger(req: Request, res: Response, next: NextFunction) {
  const requestId = randomUUID();
  const startedAt = Date.now();
  req.id = requestId;
  res.setHeader('X-Request-Id', requestId);
  res.on('finish', () => {
    console.log(
      \`\${requestId} \${req.method} \${req.originalUrl} \${res.statusCode} \${Date.now() - startedAt}ms\`,
    );
  });
  next();
}
",
    "path": "backend/src/middleware/logger.ts",
  },
  {
    "content": "import type { NextFunction, Request, Response } from 'express';
import { HttpError } from './errorHandler';

const WINDOW_MS = 60_000;

/** Giới hạn theo IP, đếm trong bộ nhớ của tiến trình (UserApp không có Redis) */
export function rateLimit(limit: number) {
  const hits = new Map<string, { count: number; resetAt: number }>();

  setInterval(() => {
    const now = Date.now();
    for (const [key, entry] of hits) if (entry.resetAt <= now) hits.delete(key);
  }, WINDOW_MS).unref();

  return (req: Request, res: Response, next: NextFunction) => {
    const now = Date.now();
    const key = req.ip ?? 'unknown';
    let entry = hits.get(key);
    if (!entry || entry.resetAt <= now) {
      entry = { count: 0, resetAt: now + WINDOW_MS };
      hits.set(key, entry);
    }
    entry.count += 1;
    if (entry.count > limit) {
      res.setHeader(
        'Retry-After',
        String(Math.ceil((entry.resetAt - now) / 1000)),
      );
      throw new HttpError(429, 'RATE_LIMITED', 'Quá nhiều yêu cầu');
    }
    next();
  };
}
",
    "path": "backend/src/middleware/rateLimit.ts",
  },
  {
    "content": "import type { NextFunction, Request, Response } from 'express';
import type { ZodType } from 'zod';
import { HttpError } from './errorHandler';

/** Kiểm tra req.body bằng Zod và thay bằng dữ liệu đã parse (field lạ bị bỏ) */
export function validateBody(schema: ZodType) {
  return (req: Request, _res: Response, next: NextFunction) => {
    const result = schema.safeParse(req.body ?? {});
    if (!result.success) {
      throw new HttpError(
        422,
        'VALIDATION_ERROR',
        'Dữ liệu không hợp lệ',
        result.error.issues.map((issue) => ({
          path: issue.path.join('.'),
          message: issue.message,
        })),
      );
    }
    req.body = result.data;
    next();
  };
}
