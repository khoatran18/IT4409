# Sinh tự động bởi CodeFlow Studio. start.sh / start.bat sẽ sao chép file này thành .env nếu chưa có.
# Không commit .env lên git. Dùng secret mới khi triển khai thật.

DB_NAME={{project.kebabName}}
DB_USER=app
DB_PASSWORD={{deploy.secrets.dbPassword}}
{{#each deploy.db.env}}
{{key}}={{value}}
{{/each}}

JWT_SECRET={{deploy.secrets.jwtSecret}}
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Tài khoản admin đầu tiên của app; hãy đổi mật khẩu sau lần đăng nhập đầu
ADMIN_EMAIL={{dotenv deploy.admin.email}}
ADMIN_PASSWORD={{dotenv deploy.admin.password}}

FRONTEND_PORT=8080
RATE_LIMIT_PER_MIN=100
# Chỉ cần khi frontend chạy ở origin khác (khi đổi FRONTEND_PORT thì đổi theo)
CORS_ORIGIN=http://localhost:8080

# Chỉ đặt khi dùng database ngoài docker compose
# DATABASE_URL=
