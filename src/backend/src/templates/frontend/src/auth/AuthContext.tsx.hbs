import { createContext, useCallback, useContext, useEffect, useMemo, useState, type ReactNode } from 'react'
import { api, clearToken, getToken, onUnauthorized, setToken } from '../api/client'

export interface AuthUser {
  id: string
  email: string
  role: string
}

const ACTION_CODES = { create: 'C', read: 'R', update: 'U', delete: 'D' } as const

export type EntityAction = keyof typeof ACTION_CODES

/** Ma trận quyền sinh từ schema: entity -> role -> chuỗi con của "CRUD" */
const PERMISSIONS: Record<string, Record<string, string>> = {
{{#each entities}}
  {{{json this.name}}}: {{{json this.permissions}}},
{{/each}}
}

interface AuthState {
  user: AuthUser | null
  loading: boolean
  /** Quyền của role hiện tại trên entity; admin luôn được phép */
  can: (entity: string, action: EntityAction) => boolean
  login: (email: string, password: string) => Promise<void>
  logout: () => void
}

const AuthContext = createContext<AuthState | null>(null)

export function AuthProvider({ children }: { children: ReactNode }) {
  const [user, setUser] = useState<AuthUser | null>(null)
  const [loading, setLoading] = useState(() => getToken() !== null)

  const logout = useCallback(() => {
    clearToken()
    setUser(null)
  }, [])

  const login = useCallback(async (email: string, password: string) => {
    const res = await api.post('/auth/login', { email, password })
    setToken(res.data.data.accessToken)
    setUser(res.data.data.user as AuthUser)
  }, [])

  useEffect(() => {
    onUnauthorized(logout)
    if (getToken() === null) return
    api
      .get('/auth/me')
      .then((res) => setUser(res.data.data as AuthUser))
      .catch(() => undefined)
      .finally(() => setLoading(false))
  }, [logout])

  const can = useCallback(
    (entity: string, action: EntityAction) => {
      if (!user) return false
      if (user.role === 'admin') return true
      return (PERMISSIONS[entity]?.[user.role] ?? '').includes(ACTION_CODES[action])
    },
    [user],
  )

  const value = useMemo(() => ({ user, loading, can, login, logout }), [user, loading, can, login, logout])
  return <AuthContext.Provider value={value}>{children}</AuthContext.Provider>
}

export function useAuth(): AuthState {
  const context = useContext(AuthContext)
  if (!context) throw new Error('useAuth phải nằm trong AuthProvider')
  return context
}
