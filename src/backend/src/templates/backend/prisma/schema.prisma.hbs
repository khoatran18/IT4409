generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "{{#if (eq db.id "mysql")}}mysql{{else}}postgresql{{/if}}"
  url      = env("DATABASE_URL")
}
{{#each entities}}

model {{pascal}} {
  id        String   @id @default(uuid())
{{#each fields}}
  {{name}} {{prismaType type}}{{#unless required}}?{{/unless}}{{#if unique}} @unique{{/if}}
{{/each}}
{{#if ownerOnly}}
  ownerId   String
{{/if}}
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("{{this.plural}}")
}
{{/each}}
