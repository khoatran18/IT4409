import 'dotenv/config';
import { z } from 'zod';

const envSchema = z.object({
  PORT: z.coerce.number().int().default(3000),
  DATABASE_URL: z.string().min(1),
  RATE_LIMIT_PER_MIN: z.coerce.number().int().positive().default(100),
  TRUST_PROXY: z.string().default('false'),
});

const parsed = envSchema.safeParse(process.env);
if (!parsed.success) {
  const issues = parsed.error.issues
    .map((issue) => `${issue.path.join('.')}: ${issue.message}`)
    .join('; ');
  throw new Error(`Biến môi trường không hợp lệ: ${issues}`);
}

export const env = parsed.data;

/** "true"/"false", số lớp proxy, hoặc danh sách subnet theo cú pháp của Express */
export function trustProxySetting(value: string): boolean | number | string {
  if (value === 'true') return true;
  if (value === 'false' || value === '') return false;
  return /^\d+$/.test(value) ? Number(value) : value;
}
