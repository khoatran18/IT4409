{
  "name": "@codeflow/schema",
  "version": "0.0.1",
  "private": true,
  "description": "Project Schema: hợp đồng dùng chung giữa Studio FE, Studio BE và generator",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "~6.0.2",
    "vitest": "^3.2.0"
  }
}
